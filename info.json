  "options": [
    {
      "identifier": "apiKey",
      "type": "text",
      "title": "API Key",
      "defaultValue": "",
      "textConfig": {
        "type": "secure",
        "placeholderText": "sk-or-v1-..."
      }
    },
    {
      "identifier": "apiUrl",
      "type": "text",
      "title": "API URL",
      "defaultValue": "https://openrouter.ai/api/v1/audio/speech",
      "desc": "OpenRouter TTS 接口地址。远程地址必须使用 HTTPS；仅 localhost、127/8、[::1] 可使用 HTTP 调试。支持基础地址、完整 /audio/speech、legacy/custom /tts，并保留 query 参数。",
      "textConfig": {
        "type": "visible",
        "placeholderText": "https://openrouter.ai/api/v1/audio/speech"
      }
    },
